{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}
{% block title %}
  Ouvindo todos
{% endblock %}

{% block content %}
  <div class="content">
    <nav class="menu">
      <ul>
       <li>
          <a href="/">Home</a>
        </li>
        <li>
          <a href="/baralhos">Decks</a>
        </li>
        <li>
          <a href="/baralhos/{{ deck.id }}/visualizar">Voltar ao baralho</a>
        </li>
      </ul>
    </nav>
    <h2>Deck: {{ deck.name }}</h2>
    <section class="flash-cards-playing" id="flash-cards-playing">
      <h3>Audio dos arquivos</h3>
      <div class="flash-card-content">
        {% if fullAudio64 %}
          <h4>Arquivo de áudio</h4>
          <audio autoplay controls src="data:audio/mpeg;base64,{{ fullAudio64 }}" id="audio"></audio>
        {% endif %}
      </div>

      <div class="card-actions">
          <nav class="menu">
            <ul>
              <li class="mdcr-form-group">
                <a href="/baralhos/{{ deck.id }}/ouvir-todos/gravados"><button>Virar</button></a>
              </li>
            </ul>
          </nav>
        </div>
    </section>



    <script>
      function play() {
        let audio = document.getElementById('audio')
        audio.play()
      }
      play()
      
      window.onload = function () {
        window.location = '#flash-cards-playing'
      }
    </script>
  </div>
{% endblock %}
