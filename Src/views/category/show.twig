{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}

{% block content %}
	<link rel="stylesheet" href="{{ asset('css/categories.css') }}">
	<div class="content">
		{% include 'templates/menu.twig' %}

		<section class="courses">
			<h4>Categoria: {{ category.name }}</h4>
			<div>
				<h3>Decks</h3>
				<hr>
			</div>
			<div class="flex flex-md-row flex-sm-column flex-wrap justify-center">

				{% for deck in decks %}
        <div>
					<a href="/baralhos/{{ deck.id }}/jogar/frente/audio" class="mdcr-sm-w-12 mdcr-md-w-4  flex mx-lg-1 mx-1 mdcr-card-a">

						<div class="mdcr-card mdcr-card-course-show">
							<img src="/{{ deck.thumbnail }}"/>
							<div class="mdcr-w-12">
								<div class="card-title">
									{{ deck.name }}</div>
							</div>
							<hr>
							{# <span>{{ category.description }}</span> #}
						</div>
					</a>
          <a href="/baralhos/{{ deck.id }}/visualizar" class="manager">Gerenciar</a>
          <a href="/baralhos/{{ deck.id }}/visualizar" class="manager">{{ deck.wasPlayed }}</a>
          </div>
				{% endfor %}
			</div>

		</section>
		<a class="add-new-float" href="/categorias/{{ category.id }}/baralhos/criar">+</a>
	</div>
{% endblock %}
