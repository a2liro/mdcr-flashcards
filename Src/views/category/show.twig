{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}

{% block content %}
  <div class="content">
    {% include 'templates/menu.twig' %}
    <section class="organizations">
    <h2>{{ category.name }}</h2>
      <h4>Decks</h4>

      <div class="flex flex-md-row flex-sm-column flex-wrap justify-center">

        {% for deck in decks %}
          <a href="/baralhos/{{ deck.id }}/visualizar"
             class="mdcr-sm-w-12 mdcr-md-w-4 mdcr-lg-w-3 flex flex-column mx-lg-1 mx-1 text-decoration-none">

            <div class="mdcr-card">
              <img src="/{{ deck.thumbnail }}"/>
              <div class="mdcr-w-12">
                <h3>
                {{ deck.name }}</div>
              </h3>
              <hr>
              <span>{{ deck.description }}</span>
            </div>
          </a>
        {% endfor %}
      </div>
