{% extends './templates/base.twig' %}
{% use "./templates/head.twig" %}
{% block title %}
  Deck - Criar
{% endblock %}
{% block content %}
  <div class="content">
    <nav class="menu">
      <ul>
        <li>
          <a href="/">Home</a>
        </li>
        <li>
          <a href="/baralhos">Decks</a>
        </li>
      </ul>
    </nav>
    <h1>Novo Curso</h1>
    <div class="container mdcr-h-center">
      <div class="mdcr-card">
        <form action="/organizacoes/{{ organizationId }}/cursos/criar" method="POST" class="mdcr-form-middle" enctype="multipart/form-data" >
          <div class="mdcr-form-group">
            <label for="name">Nome do curso</label>
            <input type="text" name="name" placeholder="Nome curso" required />
          </div>

          <div class="mdcr-form-group">
            <label for="name">Descrição breve do curso</label>
            <input type="text" name="name" placeholder="Descrição" required />
          </div>

          <div class="mdcr-form-group">
            <label for="thumbnail">Thumbnail do curso</label>
            <input type="file" name="thumbnail" id="thumbnail" accept="image/jpeg" placeholder="Thumbnail do curso" />
          </div>

          <div class="mdcr-form-group">
            <input type="submit" value="Cadastrar curso" />
          </div>
        </form>
      </div>
    </div>
  </div>
{% endblock %}
