{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}

{% block content %}
	<link rel="stylesheet" href="{{ asset('css/courses.css') }}">

	<div class="content">
		{% include 'templates/menu.twig' %}
		<section class="courses">
			<h4>Curso: {{ course.name }}</h4>
			<div>
				<h3>Categorias</h3>
				<hr>
			</div>
			<div class="flex flex-md-row flex-sm-column flex-wrap justify-center">

				{% for category in categories %}
					<a href="/categorias/{{ category.id }}/visualizar" class="mdcr-sm-w-12 mdcr-md-w-4  flex mx-lg-1 mx-1 mdcr-card-a">

						<div class="mdcr-card mdcr-card-course-show">
							<img src="/{{ category.thumbnail }}"/>
							<div class="mdcr-w-12">
								<h3>
									{{ category.name }}
								</h3>
							</div>
							<hr>
							{# <span>{{ category.description }}</span> #}
						</div>
					</a>
				{% endfor %}
			</div>

		</section>
		<a class="add-new-float" href="/cursos/{{ course.id }}/categorias/criar">+</a>
	</div>
{% endblock %}
