{% extends './templates/base.twig' %}
{% use "./templates/head.twig" %}
{% block title %}
  Editar cartão
{% endblock %}
{% block content %}
  <div class="content">
    <nav class="menu">
      <ul>
        <li>
          <a href="/">Home</a>
          <a href="/baralhos/{{ deckId }}/visualizar">Ver baralho</a>
        </li>
      </ul>
    </nav>
    <h1>Novo flash card</h1>
    <div class="container mdcr-h-center">
      <div class="mdrc-card">
        <form action="/baralhos/{{ deckId }}/flash-cards/{{ flashCard.id }}/update" method="POST" class="mdcr-form-middle" enctype="multipart/form-data">
          <div class="mdcr-form-group">
            <label for="front">Frente</label>
            <input type="text" name="front" value="{{ flashCard.front }}" placeholder="Frente" required />
          </div>

          <div class="mdcr-form-group">
            <label for="back">Verso</label>
            <input type="text" name="back" value="{{ flashCard.back }}" placeholder="Verso" required />
          </div>

          <div class="mdcr-form-group">
            <input type="hidden" name="image64" id="image" value="{{ flashCard.image64 }}" />
          </div>
          <div class="image">
            <img src="data:image/*;base64,{{ flashCard.image64 }}" id="image-preview-create" alt="" />
          </div>

          <div class="mdcr-form-group">
            <label for="image">Imagem</label>
            <input type="file" name="image" id="image" accept="image/*" onchange="showPreview(event)" placeholder="Imagem" />
          </div>

          <div class="mdcr-form-group">
            <label for="image">Audio</label>
            <input type="file" name="audiofile" id="audiofile" accept="audio/*" onchange="showPreviewAudio(event)" placeholder="Arquivo de áudio" />
          </div>

          {% if flashCard.audioFile64 %}
            <div class="mdcr-form-group">
              <audio controls src="data:audio/mpeg;base64,{{ flashCard.audioFile64 }}" id="audio-preview-container"></audio>
            </div>
             <div class="mdcr-form-group">
            <input type="hidden" name="audiofile64" id="audiofile64" value="{{ flashCard.audioFile64 }}" />
          </div>
          {% else %}
            <div class="mdcr-form-group">
              <audio controls style="display: none;" src="{{ flashCard.audioFile64 }}" id="audio-preview-container"></audio>
            </div>
          {% endif %}

          <div class="mdcr-form-group">
            <input type="hidden" name="audio" capture id="audio" value="{{ flashCard.audio }}" />
          </div>

          <div class="wrapper">
            <section class="main-controls">
              <canvas class="visualizer" height="60px"></canvas>
              <div id="buttons">
                <button class="record mdcr-half-button audio-control-buttons" type="button">Gravar</button>
                <button class="stop mdcr-half-button audio-control-buttons" type="button">Parar</button>
              </div>
            </section>

            <section class="sound-clips">
              <article class="clip">
                <audio controls="" src="data:audio/mpeg;base64,{{ flashCard.audio }}"></audio>
                <button class="delete mdcr-half-button audio-control-buttons">Excluir</button>
              </article>
            </section>
          </div>

          <script src="/assets/js/audio-recorder.js"></script>

          <div class="mdcr-form-group submit">
            <input type="submit" value="Editar flash card" />
          </div>
        </form>
      </div>
    </div>
    <script>
      function showPreview(event) {
        if (event.target.files.length > 0) {
          var src = URL.createObjectURL(event.target.files[0])
          var preview = document.getElementById('image-preview-create')
          preview.src = src
          preview.style.display = 'block'
        }
      }

      function showPreviewAudio(event) {
              if (event.target.files.length > 0) {
                console.log(event.target.files)
                var src = URL.createObjectURL(event.target.files[0])
                //var preview = document.getElementById('audio-preview-create')
            
                //preview.src = src
                //preview.style.display = 'block'
                let container = document.getElementById('audio-preview-container')
                container.style.display = 'block'
                container.setAttribute('src', src)
              }
            }
    </script>
  </div>
{% endblock %}
