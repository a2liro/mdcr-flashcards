{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}

{% block content %}
  <div class="content">
    {% include 'templates/menu.twig' %}
    <section class="organizations">
    <h4>{{ organization.name }}</h4>
      <h4>Cursos</h4>
      <ul class="mdcr-model-list">
        {% for course in courses %}
          <li>
            <span>{{ course.name }}</span>
            <div class="actions">
              <a href="/cursos/{{ course.id }}/visualizar">{{ icon('show', 'blue') }}</a>
              <a href="/cursos/{{ course.id }}/editar">{{ icon('edit', 'green') }}</a>
              <a href="/cursos/{{ course.id }}/excluir">{{ icon('delete', 'red') }}</a>
            </div>
          </li>
        {% endfor %}
      </ul>
    </section>
    <a class="add-new-float" href="/organizacoes/{{ organization.id }}/cursos/criar">+</a>
  </div>
{% endblock %}
