{% extends "./templates/base.twig" %}
{% use "./templates/head.twig" %}


{% block content %}
	<link rel="stylesheet" href="{{ asset('css/register.css') }}">
	<div class="container mdcr-h-center">
		<div class="mdcr-card">
			<div class="flex justify-center logo">
				<img src="{{ asset('images/mdcr_logo.png') }}" alt="Logo!"/>
			</div>
			<h2>Contato</h2>
			<form action="/register" method="POST" class="mdcr-form-middle">
				<div class="mdcr-form-group">
					<label for="email">Nome</label>
					<input type="text" name="name">
				</div>
				<div class="mdcr-form-group">
					<label for="company">Empresa</label>
					<input type="text" name="company">
				</div>
				<div class="mdcr-form-group">
					<label for="phone">Telefone/Whatsapp</label>
					<input type="text" name="phone">
				</div>
				<div class="mdcr-form-group">
					<label for="email">Email</label>
					<input type="email" name="email">
				</div>
				<div class="mdcr-form-group">
					<input type="submit" value="Enviar">
				</div>
			</form>
      <br>
      <div>Já tem uma conta? <a href="/login">Entre</a></div>
      <br>
      <div>Não achou o que procura? <a href="/">Paǵina inicial</a></div>
		</div>

	</div>
{% endblock %}
