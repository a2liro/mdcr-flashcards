<!DOCTYPE html>
<html>
  <head>
    {% block head %}

    {% endblock %}
    <title>
      {% block title %}

      {% endblock %} - MDCR Flashcards
    </title>
  </head>
  <body class="d-flex flex-column min-vh-100">
    <content>
      <div id="content">
        {% block content %}

        {% endblock %}
      </div>
    </content>
    <footer class="mt-auto">
      <div id="footer">
        {% block footer %}
          &copy; MDCR - Flashcards <a href="http://flashcards.mdcr.com.br/">Flashcards</a>.
        {% endblock %}
      </div>
    </footer>
  </body>
</html>
