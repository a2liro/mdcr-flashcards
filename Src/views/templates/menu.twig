{% block menu %}
	<style>

		.container {
			display: inline-block;
			cursor: pointer;
		}

		.bar1,
		.bar2,
		.bar3 {
			width: 35px;
			height: 5px;
			background-color: #333;
			margin: 6px 0;
			transition: 0.4s;
		}

		.change .bar1 {
			transform: translate(0, 11px) rotate(-45deg);
		}

		.change .bar2 {
			opacity: 0;
		}

		.change .bar3 {
			transform: translate(0, -11px) rotate(45deg);
		}

    .global-menu {
      opacity: 0;
      height: 1px;
      position:relative;
      top: -12em;
      transition: all 1s;
    }

     .global-menu-open {
      opacity: 1;
      height: 10em;
      position: relative;
      top: 0em;
      transition: all 0.5s linear;
    }
	</style>
	<nav class="menu">
		<div class="container" onclick="myFunction(this)">
			<div class="bar1"></div>
			<div class="bar2"></div>
			<div class="bar3"></div>
		</div>
    <div id="global-menu" class="global-menu">
		<ul>
			<li><a href="/">Home</a></li>
			<li><a href="/organizacoes">Organização</a></li>
			<li><a href="/cursos">Cursos</a></li>
			<li><a href="/logout">Sair</a></li>
		</ul>
    	</div>
	</nav>

	<script>
		function myFunction(x) {
x.classList.toggle("change");
let menuButton = document.getElementById('global-menu');
menuButton.classList.toggle("global-menu-open");
}
	</script>
{% endblock %}
