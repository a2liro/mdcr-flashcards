{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}
{% block title %}
  Ouvindo todos
{% endblock %}

{% block content %}
  <div class="content">
    <nav class="menu">
      <ul>
        <li>
          <a class="back-button" href="/categorias/{{ deck.category_id }}/visualizar" >
          {{ icon('back', '#528461') }} <span>Voltar</span>
          </a>
        </li>
      </ul>
    </nav>
    <h4>Deck: {{ deck.name }}</h4>
    <section class="cards-playing" id="cards-playing">
      <div class="card-content">
          {% if card.audioFile64 %}
              <audio autoplay controls src="data:audio/mpeg;base64,{{ card.audioFile64 }}" id="audio"></audio>
          {% endif %}

          {% if card.audio64 %}
              <h4>Gravação de áudio</h4>
              <audio controls src="data:audio/mpeg;base64,{{ card.audio64 }}" id="audio"></audio>
          {% endif %}
      </div>

      <div class="card-actions">
          <nav class="menu">
            <ul>
              <li class="mdcr-form-group">
                <a href="/baralhos/{{deck.id}}/jogar/frente/card/{{card.id}}"><button>Próximo</button></a>
              </li>
            </ul>
          </nav>
        </div>
    </section>



    <script>
      function play() {
        let audio = document.getElementById('audio')
        audio.play()
      }
      play()

      window.onload = function () {
        window.location = '#cards-playing'
      }
    </script>
  </div>
{% endblock %}
