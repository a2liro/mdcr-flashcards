{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}

{% block title %}
  Baralhos - {{ deck.name }}
{% endblock %}

{% block content %}
  <meta name="twitter:description" content="Quill is a free, open source rich text editor built for the modern web." />
  <meta name="twitter:image" content="https://quilljs.com/assets/images/brand-asset.png" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://quilljs.com/standalone/full/" />
  <meta property="og:image" content="https://quilljs.com/assets/images/brand-asset.png" />
  <meta property="og:title" content="Full Editor - Quill" />
  <meta property="og:site_name" content="Quill" />
  <link rel="stylesheet" href="/assets/js/quill/quill.core.css" />
  <link rel="stylesheet" href="/assets/js/quill/quill.snow.css" />

  <link rel="canonical" href="https://quilljs.com/standalone/full/" />
  <link type="application/atom+xml" rel="alternate" href="https://quilljs.com/feed.xml" title="Quill - Your powerful rich text editor" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.7.1/katex.min.css" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/9.12.0/styles/monokai-sublime.min.css" />

  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/9.12.0/highlight.min.js"></script>

  <script src="/assets/js/quill/quill.min.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.7.1/katex.min.js"></script>

  <div class="content">
    {% include 'templates/menu.twig' %}
    <h1>Baralhos - {{ deck.name }} - {{ flashCards|length }} cartas</h1>
    <div class="mdcr-form-group mdcr-form-group-row">
      {% if deck.cardsToPlay > 0 %}
        <a class="mdcr-half-button" href="/baralhos/{{ deck.id }}/jogar/frente/audio"><button class="mdcr-half-button">Estudar ({{ deck.cardsToPlay }})</button></a>
      {% else %}
        <a class="mdcr-half-button" href="#"><button class="mdcr-half-button">Nada por aqui</button></a>
      {% endif %}
      <a class="mdcr-half-button" href="/baralhos/{{ deck.id }}/ouvir-todos"><button class="mdcr-half-button">Ouvir todos</button></a>
    </div>

    <section class="categories">
      <h2>flash-cards</h2>
      <a href="/baralhos/{{ deck.id }}/flash-cards/criar">+ flash card</a>
      <ul class="mdcr-model-list">
        {% for flashCard in flashCards %}
          <li>
            <span>
              <div id="standalone-container">
                <div id="editor-container-{{ flashCard.id }}"></div>
              </div>
            </span>

            {# <span>{{ flashCard.front }}</span> <span>{{ flashCard.back }}</span> #}
            <div class="actions">
              <a href="/baralhos/{{ deck.id }}/flash-cards/{{ flashCard.id }}/visualizar">{{ icon('show', 'blue') }}</a>
              <a href="/baralhos/{{ deck.id }}/flash-cards/{{ flashCard.id }}/editar">{{ icon('edit', 'green') }}</a>
              <a href="/baralhos/{{ deck.id }}/flash-cards/{{ flashCard.id }}/excluir">{{ icon('delete', 'red') }}</a>
            </div>
          </li>
          <input type="hidden" id="front-input-{{ flashCard.id }}" value="{{ flashCard.front }}" />

          <script>
            var quill = new Quill('#editor-container-{{ flashCard.id }}', {
              theme: 'bubble'
            })
            let frontInput{{ flashCard.id }} = document.getElementById('front-input-{{ flashCard.id }}')
            quill.setContents(JSON.parse(frontInput{{ flashCard.id }}.value))
            quill.enable(false)
          </script>
        {% endfor %}
      </ul>
    </section>

    <a class="add-new-float" href="/baralhos/criar">+</a>
  </div>
{% endblock %}
