{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}

{% block title %}
  Deck - {{ deck.name }}
{% endblock %}

{% block content %}
  <meta name="twitter:description" content="Quill is a free, open source rich text editor built for the modern web." />
  <meta name="twitter:image" content="https://quilljs.com/assets/images/brand-asset.png" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://quilljs.com/standalone/full/" />
  <meta property="og:image" content="https://quilljs.com/assets/images/brand-asset.png" />
  <meta property="og:title" content="Full Editor - Quill" />
  <meta property="og:site_name" content="Quill" />
  <link rel="stylesheet" href="/assets/js/quill/quill.core.css" />
  <link rel="stylesheet" href="/assets/js/quill/quill.snow.css" />

  <link rel="canonical" href="https://quilljs.com/standalone/full/" />
  <link type="application/atom+xml" rel="alternate" href="https://quilljs.com/feed.xml" title="Quill - Your powerful rich text editor" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.7.1/katex.min.css" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/9.12.0/styles/monokai-sublime.min.css" />

  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/9.12.0/highlight.min.js"></script>

  <script src="/assets/js/quill/quill.min.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.7.1/katex.min.js"></script>

  <div class="content">
    {% include 'templates/menu.twig' with {user:user} only %}
    <h3>Deck: {{ deck.name }}</h3>
    <h3>Cards novos: {{ totalNewCards }}</h3>
    <h3>Cards para repetir: {{ totalCardsToPlayAgain }} </h3>
    <h3>Total de cards: {{ cards|length }}</h3>
    <h3>Repetições executadas: {{ totalPlayedCards }}</h3>

    <section class="categories">
      {% if user.type == 'student' %}
        <a href="/baralhos/{{ deck.id }}/reiniciar">Reiniciar deck</a>
      {% else %}
       <h4>cards</h4>
      <a href="/baralhos/{{ deck.id }}/cards/criar">+ flash card</a>
      <ul class="mdcr-model-list">
        {% for card in cards %}
          <li>
            <span>
              <div id="standalone-container">
                <div id="editor-container-{{ card.id }}"></div>
                
              </div>
            </span>
            <span>
              <div id="standalone-container">
                <div id="editor-container-back{{ card.id }}"></div>
              </div>
            </span>

            <div class="actions">
              <a href="/baralhos/{{ deck.id }}/cards/{{ card.id }}/visualizar">{{ icon('show', 'blue') }}</a>
              <a href="/baralhos/{{ deck.id }}/cards/{{ card.id }}/editar">{{ icon('edit', 'green') }}</a>
              <a href="/baralhos/{{ deck.id }}/cards/{{ card.id }}/excluir">{{ icon('delete', 'red') }}</a>
            </div>
          </li>
          <input type="hidden" id="front-input-{{ card.id }}" value="{{ card.front }}" />
          <input type="hidden" id="back-input{{ card.id }}" value="{{ card.back }}" />

          <script>
            var quill = new Quill('#editor-container-{{ card.id }}', {
              theme: 'bubble'
            })
            let frontInput{{ card.id }} = document.getElementById('front-input-{{ card.id }}')
            quill.setContents(JSON.parse(frontInput{{ card.id }}.value))
            quill.enable(false)
          </script>

           <script>
            var quillBack = new Quill('#editor-container-back{{ card.id }}', {
              theme: 'bubble'
            })
            let backInput{{ card.id }} = document.getElementById('back-input{{ card.id }}')
            quillBack.setContents(JSON.parse(backInput{{ card.id }}.value))
            quillBack.enable(false)
          </script>
        {% endfor %}
      </ul>
      {% endif %}
    </section>

    <a class="add-new-float" href="/baralhos/criar">+</a>
  </div>
{% endblock %}
