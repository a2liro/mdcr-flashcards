{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}
{% block title %}
  Jogando - Frente
{% endblock %}
{% block content %}
  <meta name="twitter:description" content="Quill is a free, open source rich text editor built for the modern web." />
  <meta name="twitter:image" content="https://quilljs.com/assets/images/brand-asset.png" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://quilljs.com/standalone/full/" />
  <meta property="og:image" content="https://quilljs.com/assets/images/brand-asset.png" />
  <meta property="og:title" content="Full Editor - Quill" />
  <meta property="og:site_name" content="Quill" />
  <link rel="stylesheet" href="/assets/js/quill/quill.core.css" />
  <link rel="stylesheet" href="/assets/js/quill/quill.snow.css" />

  <link rel="canonical" href="https://quilljs.com/standalone/full/" />
  <link type="application/atom+xml" rel="alternate" href="https://quilljs.com/feed.xml" title="Quill - Your powerful rich text editor" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.7.1/katex.min.css" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/9.12.0/styles/monokai-sublime.min.css" />
  <div class="content">
    <nav class="menu">
      <ul>
        <li>
          <a href="/">Home</a>
        </li>
        <li>
          <a href="/baralhos">Decks</a>
        </li>
        <li>
          <a href="/baralhos/{{ deck.id }}/visualizar">Voltar ao baralho</a>
        </li>
      </ul>
    </nav>
    <h4>Deck: {{ deck.name }}</h4>
    {% if card.id %}
      <section class="cards-playing" id="cards-playing">
        <h3>Frente:</h3>
        {# <span>{{ card.front }}</span> #}

        <h3>Verso:</h3>
        <div class="card-content">
          {# <span>{{ card.back }}</span> #}
          <div id="standalone-container">
            <div id="editor-container-back"></div>
          </div>
        </div>

        <div class="card-actions">
          <nav class="menu">
            <ul>
              <li class="mdcr-form-group">
                <a href="/baralhos/{{ deck.id }}/jogar/verso/card/{{ card.id }}/reverso"><button>Virar</button></a>
              </li>
            </ul>
          </nav>
        </div>
      </section>
      <a class="add-new-float" href="/baralhos/{{ deck.id }}/cards/{{ card.id }}/editar">{{ icon('edit', 'white') }}</a>
    {% else %}
      <h4>Nada a revisar no momento</h4>
      <div>
        <a href="/baralhos/{{ deck.id }}/cards/criar">+ flash card</a>
      </div>
    {% endif %}

    {# <input type="hidden" id="front-input" value="{{ card.front }}" /> #}
    <input type="hidden" id="back-input" value="{{ card.back }}" />

    <script>
      function play() {
        let audio = document.getElementById('audio')
        audio.play()
      }
      play()

      window.onload = function () {
        window.location = '#cards-playing'
      }
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/9.12.0/highlight.min.js"></script>

    <script src="/assets/js/quill/quill.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.7.1/katex.min.js"></script>

    {# <script>
         var quill = new Quill('#editor-container', {
           theme: 'bubble'
         })
         let frontInput = document.getElementById('front-input')
         quill.setContents(JSON.parse(frontInput.value))
         quill.enable(false)
       </script> #}

    <script>
      var quillBack = new Quill('#editor-container-back', {
        theme: 'bubble'
      })
      let backInput = document.getElementById('back-input')
      quillBack.setContents(JSON.parse(backInput.value))
      quillBack.enable(false)
    </script>
  </div>
{% endblock %}
