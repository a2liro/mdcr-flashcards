{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}
{% block title %}Jogando - Verso{% endblock %}

{% block content %}
  {% include 'templates/menu.twig' %}
  <h1>Jogando - {{ deck.name }}</h1>
  {% if card.id %}
    <section class="flash-cards-playing">
      <h2>Frente</h2>
      <h3>{{ card.front }}</h3>
      <audio autoplay controls src="data:audio/mpeg;base64,{{ card.audio }}" id="audio"></audio>
      <div class="card-actions">
        <nav class="menu">
          <ul>
            <li class="mdcr-form-group">
              <a href="/baralhos/{{ deck.id }}/jogar/verso/card/{{ card.id }}">
              <button>Virar</button>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </section>
  {% else %}
    <section>
      <h1>Sem cards no momento</h1>
      <div>
        <a href="/baralhos/{{ deck.id }}/flash-cards/criar">+ flash card</a>
      </div>
    </section>
  {% endif %}
  <script>
    function play() {
      let audio = document.getElementById('audio')
      audio.play()
    }
    play()
  </script>
{% endblock %}
