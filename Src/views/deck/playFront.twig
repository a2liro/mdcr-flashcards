{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}
{% block title %}
  Jogando - Verso
{% endblock %}

{% block content %}
  <meta name="twitter:description" content="Quill is a free, open source rich text editor built for the modern web." />
  <meta name="twitter:image" content="https://quilljs.com/assets/images/brand-asset.png" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://quilljs.com/standalone/full/" />
  <meta property="og:image" content="https://quilljs.com/assets/images/brand-asset.png" />
  <meta property="og:title" content="Full Editor - Quill" />
  <meta property="og:site_name" content="Quill" />
  <link rel="stylesheet" href="/assets/js/quill/quill.core.css" />
  <link rel="stylesheet" href="/assets/js/quill/quill.snow.css" />

  <link rel="canonical" href="https://quilljs.com/standalone/full/" />
  <link type="application/atom+xml" rel="alternate" href="https://quilljs.com/feed.xml" title="Quill - Your powerful rich text editor" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.7.1/katex.min.css" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/9.12.0/styles/monokai-sublime.min.css" />
  <div class="content">
      <input type="hidden" id="front-input" value="{{ card.front }}" />

    <nav class="menu">
      <ul>
        <li>
          <div class="back-button" onclick="history.back()">
          {{ icon('back', '#528461') }} <span>Voltar</span>
          </div>
        </li>
      </ul>
    </nav>
    <h4>Deck: {{ deck.name }}</h4>
    {% if card.id %}
      <section class="cards-playing" id="cards-playing">
        <span class="title-card-side">Frente:</span>
        <div class="card-content">
          <div id="standalone-container">
            <div id="editor-container"></div>
          </div>

          {% if card.audioFile64 %}
            <audio autoplay controls src="data:audio/mpeg;base64,{{ card.audioFile64 }}" id="audio"></audio>
          {% endif %}

          {% if card.audio64 %}
            <h4>Gravação de áudio</h4>
            <audio controls src="data:audio/mpeg;base64,{{ card.audio64 }}" id="audio"></audio>
          {% endif %}
        </div>

          {% if deck.is_english == '1' %}
            <div class="mdcr-form-group submit">
              <button id="start" class="mdcr-button audio-control-buttons" type="button">Treinar pronúncia</button>
              <div class="words" style="display:none;">
                <p id="p"></p>
              </div>
              <div id="result"></div>
            </div>

            <pre id="display"></pre>
<script src="/assets/js/diff.js"></script>
<script defer="">
var a = document.getElementById('front-input');
var b = document.getElementById('p');
var result = document.getElementById('result');

function changed() {
  let aValue = a.value
  .replace('"ops":', '')
  .replace('"insert":', '')
  .replace("\\n", '')
  .replace(/[\[\]{}"]/g, '')
  .toLowerCase();
	var diff = JsDiff['diffChars'](aValue, b.textContent.toLowerCase());
	var fragment = document.createDocumentFragment();
	for (var i=0; i < diff.length; i++) {

		if (diff[i].added && diff[i + 1] && diff[i + 1].removed) {
			var swap = diff[i];
			diff[i] = diff[i + 1];
			diff[i + 1] = swap;
		}

		var node;
		if (diff[i].removed) {
			node = document.createElement('del');
			node.appendChild(document.createTextNode(diff[i].value));
		} else if (diff[i].added) {
			node = document.createElement('ins');
			node.appendChild(document.createTextNode(diff[i].value));
		} else {
			node = document.createTextNode(diff[i].value);
		}
		fragment.appendChild(node);
	}

	result.textContent = '';
	result.appendChild(fragment);
}

window.onload = function() {
	onDiffTypeChange(document.querySelector('#settings [name="diff_type"]:checked'));
	changed();
};

a.onpaste = a.onchange =
b.onpaste = b.onchange = changed;

if ('oninput' in a) {
	a.oninput = b.oninput = changed;
} else {
	a.onkeyup = b.onkeyup = changed;
}

function onDiffTypeChange(radio) {
	window.diffType = radio.value;
	document.title = "Diff " + radio.value.slice(4);
}
</script>
          {% endif %}

        <div class="card-actions">
          <nav class="menu">
            <ul>
              <li class="mdcr-form-group">
                <a href="/baralhos/{{ deck.id }}/jogar/verso/card/{{ card.id }}"><button>Virar</button></a>
              </li>
            </ul>
          </nav>
        </div>
      </section>
    {% else %}
      <section>
        <h3>Sem cards no momento</h3>
        <div>
          <a href="/baralhos/{{ deck.id }}/cards/criar">+ flash card</a>
        </div>
      </section>
    {% endif %}

    <script>
      function play() {
        let audio = document.getElementById('audio')
        audio.play()
      }
      play()

      window.onload = function () {
        window.location = '#cards-playing'
      }
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/9.12.0/highlight.min.js"></script>

    <script src="/assets/js/quill/quill.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.7.1/katex.min.js"></script>

    <script>
      var quill = new Quill('#editor-container', {
        theme: 'bubble'
      })
      let frontInput = document.getElementById('front-input')

      quill.setContents(JSON.parse(frontInput.value))
      quill.enable(false)
    </script>

    <script>
      let btnStart = document.getElementById('start')

      var speech = true
      window.SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition

      const recognition = new SpeechRecognition()
      recognition.interimResults = true;
      recognition.lang = 'en-US'

      recognition.addEventListener('result', (e) => {
        const transcript = Array.from(e.results)
          .map((result) => result[0])
          .map((result) => result.transcript)
          .join('')

        document.getElementById('p').innerHTML = transcript
        console.log(transcript)
        changed()
      })

      btnStart.onclick = function () {
        console.log('start')
        btnStart.classList.add('background-red')
        btnStart.innerText = 'Ouvindo...'
        recognition.start()
      }

      recognition.addEventListener('end', () => {
        recognition.stop()
        console.log('Speech recognition has stopped.')
        btnStart.classList.remove('background-red')
        btnStart.innerHTML = 'Treinar pronúncia'
      })
    </script>
    {% if user.type == 'admin'%}
			<a class="add-new-float" href="/baralhos/{{ deck.id }}/cards/{{ card.id }}/editar">{{ icon('edit', 'white') }}</a>
		{% endif %}
  </div>
{% endblock %}
