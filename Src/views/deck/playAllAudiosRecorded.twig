{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}
{% block title %}
  Ouvindo todos
{% endblock %}

{% block content %}
  <div class="content">
    <nav class="menu">
      <ul>
       <li>
          <a href="/">Home</a>
        </li>
        <li>
          <a href="/baralhos">Decks</a>
        </li>
        <li>
          <a href="/baralhos/{{ deck.id }}/visualizar">Voltar ao baralho</a>
        </li>
      </ul>
    </nav>
    <h2>Deck: {{ deck.name }}</h2>
    <section class="cards-playing" id="cards-playing">
      <h3>Audio das gravações:</h3>
      <div class="card-content">
        {% if fullAudio64 %}
          <h4>Arquivo de áudio</h4>
          <audio autoplay controls src="data:audio/mpeg;base64,{{ fullAudio64 }}" id="audio"></audio>
          {% else %}
            <h3>Você não possui áudios para esse deck</h3>
        {% endif %}
      </div>

    </section>

    <script>
      function play() {
        let audio = document.getElementById('audio')
        audio.play()
      }
      play()

      window.onload = function () {
        window.location = '#cards-playing'
      }
    </script>
  </div>
{% endblock %}
