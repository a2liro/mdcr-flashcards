{% extends 'templates/base.twig' %}
{% use "templates/head.twig" %}
{% block title %}
  Ouvindo todos
{% endblock %}

{% block content %}
  <div class="content">
    <nav class="menu">
      <ul>
        <li>
          <a href="/baralhos/{{ deck.id }}/visualizar">Voltar ao baralho</a>
        </li>
      </ul>
    </nav>
    <h1>{{ deck.name }}</h1>
    <section class="flash-cards-playing" id="flash-cards-playing">
      <h2>Audio das gravações</h2>
      <div class="flash-card-content">
        {% if fullAudio64 %}
          <h4>Arquivo de áudio</h4>
          <audio autoplay controls src="data:audio/mpeg;base64,{{ fullAudio64 }}" id="audio"></audio>
        {% endif %}
      </div>

    </section>

    <script>
      function play() {
        let audio = document.getElementById('audio')
        audio.play()
      }
      play()
      
      window.onload = function () {
        window.location = '#flash-cards-playing'
      }
    </script>
  </div>
{% endblock %}
