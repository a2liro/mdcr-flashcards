{% extends './templates/base.twig' %}
{% use "./templates/head.twig" %}
{% block title %}Baralhos - Criar{% endblock %}
{% block content %}
  <nav class="menu">
    <ul>
	 <li>
        <a href="/">Home</a>
      </li>
      <li>
        <a href="/organizacoes">Novo baralho</a>
      </li>
    </ul>
  </nav>
  <h1>Novo baralho</h1>
  <div class="container mdcr-h-center">
    <div class="mdrc-card">
      <form action="/baralhos/criar" method="POST" class="mdcr-form-middle">
        <div class="mdcr-form-group">
          <label for="name">Nome do baralho</label>
          <input type="text" name="name" placeholder="Novo baralho" required />
        </div>

        <div class="mdcr-form-group">
          <input type="submit" value="Cadastrar baralho" />
        </div>
      </form>
    </div>
  </div>
{% endblock %}
