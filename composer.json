      "App\\": "Src/",
      "MDCR\\": "Src/MDCR/",
      "MDCR\\Models\\": "Src/Models/"
    }
  },
  "require": {
    "twig/twig": "^3.3",
    "symfony/asset": "^5.3",
    "falahati/php-mp3": "dev-master",
    "google/apiclient": "^2.15.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "scripts": {
    "pre-autoload-dump": "Google\\Task\\Composer::cleanup"
  },
  "extra": {
      "google/apiclient-services": [
          "Drive",
          "YouTube"
      ]
  }
}
